# ERPmini Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# Runtime environment (development, staging, production)
ENVIRONMENT=production
DEBUG=false

# Database connection URL
# SQLite async (local development default):
# DATABASE_URL=sqlite+aiosqlite:///./erpmini.db
# PostgreSQL async (production):
DATABASE_URL=postgresql+asyncpg://erp:erp_password_change_me@localhost:5432/erpmini

# PostgreSQL container config (used by docker-compose)
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_password_change_me
POSTGRES_DB=erpmini
POSTGRES_PORT=5432

# Application security and default multi-tenant setup
SECRET_KEY=generate-a-strong-random-key-for-production-min-32-chars
DEFAULT_TENANT_ID=01950000-0000-7000-8000-000000000001

# Web Server Configuration
HOST=0.0.0.0
PORT=8000

# WhatsApp / External Bot integration
WHATSAPP_VERIFY_TOKEN=erpmini-bot-verify-secret
